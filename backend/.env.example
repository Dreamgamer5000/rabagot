
# --- Security & Authentication ---
# The password for the /admin dashboard (username is always 'admin')
ADMIN_PASSWORD=admin123

# A long random string used to sign JWT tokens for security
SECRET_KEY=ThisIsMyLongSecretKeyForJWT

# --- Face Recognition Settings ---
# Matching threshold (0.0 to 1.0). Higher = stricter matches, Lower = more matches but potentially more errors.
FACE_SIMILARITY_THRESHOLD=0.6

# --- Database & Storage Paths (Relative to backend/ directory) ---
DB_PATH=data/app.db
SERVICE_ACCOUNTS_DIR=data/accounts
