# ==============================================================================
# PICSHARE - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Generate a secure 64-character SECRET_KEY using:
#   openssl rand -hex 32
# ==============================================================================

# --- Google Cloud & VM Deployment ---
# Used for building, tagging, and running Docker images
GCP_PROJECT_ID="your-gcp-project-id"
GCP_ZONE="your-gcp-zone"
GCP_VM_NAME="your-vm-name"
GCP_REGION="your-gcp-region"
GCP_REPO_NAME="picshare-repo"
IMAGE_TAG="latest"

# --- Security & Authentication ---
# The master password for the /admin dashboard (Username is always 'admin')
ADMIN_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# Secure secret key for signing JWT session tokens
# Replace with the output of `openssl rand -hex 32`
SECRET_KEY=CHANGE_ME_GENERATED_SECRET_KEY

# --- Face Recognition & Search Settings ---
# Cosine similarity matching threshold (0.0 - 1.0). 0.6 is recommended.
FACE_SIMILARITY_THRESHOLD=0.6

# --- Performance & Concurrency Settings ---
# Concurrency limit during background operations:
# Use 12 for local Ryzen 9 multi-core workstation.
# Use 1-2 on a 4GB RAM cloud VPS.
SYNC_CONCURRENCY=2

# --- Docker Container Resource Allocation ---
# Use 12 cores / 16G RAM for local workstation; 2 cores / 4G RAM on cloud VPS.
BACKEND_CPU_COUNT=2
BACKEND_MEM_LIMIT=4G

# --- Storage & Database Paths ---
# (Mapped inside container to /app/data, backed by host's ./data volume)
DB_PATH=data/app.db
SERVICE_ACCOUNTS_DIR=data/accounts
UPLOAD_ROOT=data/uploads/originals
THUMBNAIL_ROOT=data/thumbnails
PREVIEWS_ROOT=data/previews
FACE_MODEL_ROOT=data/insightface
GUEST_SELFIES_DIR=data/uploads/selfies
